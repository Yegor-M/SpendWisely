# LLM provider for transaction categorisation: claude | openai | gemini
LLM_PROVIDER=gemini
LLM_MODEL=              # leave blank to use provider default

# Gemini (free tier via Google AI Studio — https://aistudio.google.com/apikey)
GOOGLE_API_KEY=...

# Optional: override to a paid provider
ANTHROPIC_API_KEY=sk-ant-...   # claude
OPENAI_API_KEY=sk-...          # openai / chatgpt

DB_PATH=./spendwisely.duckdb
OWNER_NAME=YOUR NAME HERE   # as it appears in bank transfer descriptions
